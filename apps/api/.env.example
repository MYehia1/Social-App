NODE_ENV=development
PORT=3000

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/echoo

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-a-64-plus-character-random-hex-string
REFRESH_TOKEN_SECRET=replace-me-with-a-different-64-plus-character-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

SALT_ROUNDS=12

# Comma-separated list of browser origins allowed to call this API
ORIGINS=http://localhost:5173

# Google Identity Services. Must be the SAME client id as
# VITE_GOOGLE_CLIENT_ID in apps/web/.env — the API checks the token's audience
# against it, so two different ids in the same project fail with
# "Could not verify that Google account". The client also needs your web
# origin (e.g. http://localhost:5173) listed under Authorized JavaScript
# origins in the Google Cloud console, or the button never renders.
GOOGLE_CLIENT_ID=

# Image uploads (optional — uploads are rejected if these are absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery for signup verification codes, sent with nodemailer.
# Leave SMTP_USER/SMTP_PASSWORD blank in development and codes are printed to
# the server log instead of being emailed. The API verifies these credentials
# at boot, so a bad password shows up in the startup log rather than as a
# signup that silently never delivers.
#
# For Gmail:
#   - SMTP_PASSWORD must be an App Password, not the account password.
#     Generate one at https://myaccount.google.com/apppasswords (the page only
#     appears once 2-Step Verification is on). Enter the 16 characters with no
#     spaces and no quotes.
#   - Gmail rewrites the From header to the authenticated mailbox, so
#     MAIL_FROM has to use the same address as SMTP_USER. Any other domain is
#     silently replaced.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Echoo <you@gmail.com>

# Used by the seed script and the web app's "Explore the demo" button
DEMO_EMAIL=demo@echoo.app
DEMO_PASSWORD=Demo@1234
