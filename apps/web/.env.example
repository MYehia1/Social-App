# Base URL of the Echoo API (no trailing slash, no /api/v1 suffix).
# Must match the port the API actually binds (apps/api/.env PORT, default
# 3000). A mismatch surfaces in the browser as "Can't reach Echoo right now",
# which looks like a network fault rather than a config one.
# Vite inlines this at server start — restart `npm run dev` after changing it.
VITE_API_BASE_URL=http://localhost:3000

# Credentials for the "Explore the demo" button on the login page.
# Leave blank to hide the button.
VITE_DEMO_EMAIL=demo@echoo.app
VITE_DEMO_PASSWORD=Demo@1234

# Google Identity Services client id (public by design — it ships in the
# bundle). Must be the SAME value as GOOGLE_CLIENT_ID in apps/api/.env.
# Leave blank to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=
